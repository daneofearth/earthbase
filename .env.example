# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# The same three values also go in the Vercel project's Environment Variables.

# ---------------------------------------------------------------- Supabase
# Project URL. Supabase dashboard → Project Settings → Data API.
SUPABASE_URL=https://mbusushrqylezifgynan.supabase.co

# SERVICE ROLE key, not the anon key. Supabase dashboard → Project Settings →
# API Keys. It bypasses row-level security, which is exactly why the tables
# have RLS on with no policies: this key is the only way in, and it is only
# ever read server-side. Treat it like a password. Never prefix it with
# NEXT_PUBLIC_ — that would ship it to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Supabase dashboard → Project Settings → API Keys.
# Safe to expose in principle, but there is no reason to: it is used only
# server-side, to act as the signed-in person during login.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- Tuner
# Who may sign in to /tune. Comma-separated, case-insensitive.
#
# This is the real lock. Supabase accepts public sign-ups by default, so
# without an allowlist "has an account" would mean "can rewrite the homepage"
# for anyone who found the URL — and the URL is in a public repo. It is checked
# when an account is created AND on every request afterwards.
#
# Leave this empty and /tune returns 404 in production. That is on purpose:
# there is then no window in which a half-configured deploy is writable.
# Not needed for local development, where /tune is open if nothing is set.
TUNE_ALLOWED_EMAILS=daneofearth@gmail.com
